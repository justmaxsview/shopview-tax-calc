{
  "manifest_version": 3,
  "name": "ShopView Tax Calculator",
  "version": "1.3.1",
  "description": "Estimated sales-tax rate by ZIP or tax region (US) or by province (Canada), in a side panel. Rates update automatically.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://justmaxsview.github.io/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ShopView Tax Calculator (Alt+Shift+T)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open the tax rate lookup"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
